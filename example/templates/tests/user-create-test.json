{
  "requestPath": "../requests/user-create-request.json",
  "tests": [
    {
      "name": "Valid User Registration Test",
      "description": "Validates successful user account creation, userId generation, role assignment, and active status.",
      "operation": "user-registration-service",
      "mutations": [
        {
          "path": "$.username",
          "value": "sarah_connor"
        },
        {
          "path": "$.email",
          "value": "sarah.connor@cyberdyne.org"
        },
        {
          "path": "$.role",
          "value": "MANAGER"
        }
      ],
      "assertions": [
        {
          "path": "$.userId",
          "operator": "STARTS_WITH",
          "value": "USR-",
          "description": "User ID must be generated with USR- prefix"
        },
        {
          "path": "$.username",
          "value": "sarah_connor",
          "description": "Username must match updated request parameter"
        },
        {
          "path": "$.email",
          "operator": "REGEX_MATCH",
          "value": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,6}$",
          "description": "Email must be a valid email format"
        },
        {
          "path": "$.role",
          "value": "MANAGER",
          "description": "Role must match assigned role"
        },
        {
          "path": "$.status",
          "value": "ACTIVE",
          "description": "Status must be ACTIVE"
        }
      ]
    }
  ]
}
