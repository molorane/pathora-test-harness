{
  "requestPath": "../requests/complex-policy-request.json",
  "tests": [
    {
      "name": "Test 1: High Risk Score Parameter Mutation Test",
      "description": "Mutates risk score and base premium, validating score bounds, price increase, single document value, region suffix, and discount cap.",
      "operation": "policy-evaluation-service",
      "mutations": [
        {
          "path": "$.insuredParty.riskMetrics.score",
          "value": 900
        },
        {
          "path": "$.coverageDetails.basePremium",
          "value": 25000.00
        }
      ],
      "assertions": [
        {
          "path": "$.riskScore",
          "operator": "GREATER_THAN_OR_EQUALS",
          "value": 900,
          "description": "Risk score must be at least 900 after mutation"
        },
        {
          "path": "$.finalPrice",
          "operator": "GREATER_THAN",
          "value": 20000.0,
          "description": "Final price must exceed 20000.0 with increased base premium"
        },
        {
          "path": "$.singlePrimaryAuditor",
          "operator": "LIST_CONTAINS_ONLY_ONE_VALUE",
          "value": "SENIOR_AUDITOR_SMITH",
          "description": "Primary auditor array must contain exactly one matching value"
        },
        {
          "path": "$.underwriterRegion",
          "operator": "ENDS_WITH",
          "value": "_SOUTH",
          "description": "Region code must end with _SOUTH"
        },
        {
          "path": "$.discountAmount",
          "operator": "LESS_THAN",
          "value": 5000.0,
          "description": "Discount amount must be less than 5000.0"
        }
      ]
    },
    {
      "name": "Test 2: Date & Time Chronology Inspection",
      "description": "Validates future expiration, before date limits, datetime after thresholds, date within next year, and past effective date.",
      "operation": "policy-evaluation-service",
      "mutations": [],
      "assertions": [
        {
          "path": "$.expirationTimestamp",
          "operator": "IS_FUTURE_DATE",
          "description": "Expiration timestamp must be in the future relative to current time"
        },
        {
          "path": "$.policyHeaderEffectiveDate",
          "operator": "DATE_BEFORE",
          "value": "2030-01-01",
          "description": "Effective date must be before 2030"
        },
        {
          "path": "$.evaluationTimestamp",
          "operator": "DATETIME_AFTER",
          "value": "2025-01-01T00:00:00",
          "description": "Evaluation timestamp must be after 2025"
        },
        {
          "path": "$.expirationTimestamp",
          "operator": "DATE_WITHIN_NEXT",
          "value": {
            "amount": 365,
            "unit": "DAYS"
          },
          "description": "Expiration timestamp must fall within next 365 days"
        },
        {
          "path": "$.policyHeaderEffectiveDate",
          "operator": "IS_PAST_DATE",
          "description": "Effective date must be in the past or present"
        }
      ]
    },
    {
      "name": "Test 3: Policy Validity Duration Verification",
      "description": "Validates exact duration in days, duration in months, duration below max years, date after duration, and date before duration.",
      "operation": "policy-evaluation-service",
      "mutations": [],
      "assertions": [
        {
          "path": "$.evaluationTimestamp",
          "operator": "DURATION_EQUALS",
          "value": {
            "startPath": "$.evaluationTimestamp",
            "endPath": "$.expirationTimestamp",
            "unit": "DAYS",
            "expected": 365
          },
          "description": "Duration between evaluation and expiration must equal 365 days"
        },
        {
          "path": "$.evaluationTimestamp",
          "operator": "DURATION_GREATER_THAN",
          "value": {
            "startPath": "$.evaluationTimestamp",
            "endPath": "$.expirationTimestamp",
            "unit": "MONTHS",
            "value": 11
          },
          "description": "Duration between dates must exceed 11 months"
        },
        {
          "path": "$.evaluationTimestamp",
          "operator": "DURATION_LESS_THAN",
          "value": {
            "startPath": "$.evaluationTimestamp",
            "endPath": "$.expirationTimestamp",
            "unit": "YEARS",
            "value": 2
          },
          "description": "Duration between dates must be less than 2 years"
        },
        {
          "path": "$.evaluationTimestamp",
          "operator": "DATE_AFTER_DURATION",
          "value": {
            "basePath": "$.evaluationTimestamp",
            "comparePath": "$.expirationTimestamp",
            "amount": 360,
            "unit": "DAYS"
          },
          "description": "Expiration must be after evaluation + 360 days"
        },
        {
          "path": "$.evaluationTimestamp",
          "operator": "DATE_BEFORE_DURATION",
          "value": {
            "basePath": "$.evaluationTimestamp",
            "comparePath": "$.expirationTimestamp",
            "amount": 400,
            "unit": "DAYS"
          },
          "description": "Expiration must be before evaluation + 400 days"
        }
      ]
    },
    {
      "name": "Test 4: Excluded Risk Flags & Value Constraints",
      "description": "Validates partial list non-containment, exact reference array values, non-existent path absence, non-empty legal name, and minimum clauses count.",
      "operation": "policy-evaluation-service",
      "mutations": [],
      "assertions": [
        {
          "path": "$.riskFlags",
          "operator": "DOES_NOT_CONTAIN_ALL",
          "value": [
            "FLOOD",
            "EARTHQUAKE",
            "VOLCANO"
          ],
          "description": "Risk flags must not contain all of FLOOD, EARTHQUAKE, VOLCANO"
        },
        {
          "path": "$.uniqueReferenceCodes",
          "operator": "LIST_CONTAINS_ONLY_VALUES",
          "value": [
            "REF-101",
            "REF-102",
            "REF-103"
          ],
          "description": "Reference codes array must contain only specified values in any order"
        },
        {
          "path": "$.nonExistentField",
          "operator": "PATH_NOT_EXISTS",
          "description": "nonExistentField must not exist in response"
        },
        {
          "path": "$.insuredPartyLegalName",
          "operator": "NOT_EQUALS",
          "value": "",
          "description": "Legal name must not be empty string"
        },
        {
          "path": "$.appliedClausesCount",
          "operator": "GREATER_THAN_OR_EQUALS",
          "value": 1,
          "description": "Applied clauses count must be at least 1"
        }
      ]
    },
    {
      "name": "Test 5: Comprehensive Logical & Structural Verification",
      "description": "Validates complex AND conditions, OR alternatives, NOT constraints, map object equality, and exact price calculations.",
      "operation": "policy-evaluation-service",
      "mutations": [],
      "assertions": [
        {
          "path": "$",
          "operator": "AND",
          "description": "Status is APPROVED AND legalName is Pathora Enterprise Solutions",
          "assertions": [
            {
              "path": "$.status",
              "value": "APPROVED"
            },
            {
              "path": "$.insuredPartyLegalName",
              "value": "Pathora Enterprise Solutions"
            }
          ]
        },
        {
          "path": "$",
          "operator": "OR",
          "description": "Credit rating is AA+ or AAA",
          "assertions": [
            {
              "path": "$.creditRating",
              "value": "AA+"
            },
            {
              "path": "$.creditRating",
              "value": "AAA"
            }
          ]
        },
        {
          "path": "$",
          "operator": "NOT",
          "description": "Status is NOT SUSPENDED",
          "assertions": [
            {
              "path": "$.status",
              "value": "SUSPENDED"
            }
          ]
        },
        {
          "path": "$.underwriterSummary",
          "operator": "OBJECT_CONTAINS_FIELDS",
          "value": {
            "code": "UW-NORTH-99",
            "region": "AFRICA_SOUTH"
          },
          "description": "Underwriter summary must contain code and region"
        },
        {
          "path": "$.finalPrice",
          "value": 14450.0,
          "description": "Final price must equal 14450.0"
        }
      ]
    }
  ]
}
