{
  "requestPath": "../requests/inventory-update-request.json",
  "tests": [
    {
      "name": "Inventory Stock Restock Test",
      "description": "Validates stock level increase, stock status IN_STOCK, and product unit price.",
      "operation": "inventory-update-service",
      "mutations": [
        {
          "path": "$.productId",
          "value": "SKU-90882"
        },
        {
          "path": "$.addQuantity",
          "value": 250
        },
        {
          "path": "$.unitPrice",
          "value": 18.75
        }
      ],
      "assertions": [
        {
          "path": "$.productId",
          "value": "SKU-90882",
          "description": "Product ID must match updated value"
        },
        {
          "path": "$.stockLevel",
          "operator": "GREATER_THAN_OR_EQUALS",
          "value": 200,
          "description": "Stock level must be at least 200 units"
        },
        {
          "path": "$.stockStatus",
          "value": "IN_STOCK",
          "description": "Stock status must be IN_STOCK"
        },
        {
          "path": "$.unitPrice",
          "value": 18.75,
          "description": "Unit price must match input unit price"
        }
      ]
    }
  ]
}
