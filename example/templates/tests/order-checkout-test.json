{
  "requestPath": "../requests/order-checkout-request.json",
  "tests": [
    {
      "name": "Order Checkout Calculation Test",
      "description": "Validates total items, subtotal, 15% tax calculation, and order status upon checkout.",
      "operation": "order-processing-service",
      "mutations": [
        {
          "path": "$.customerId",
          "value": "CUST-99001"
        },
        {
          "path": "$.currency",
          "value": "USD"
        }
      ],
      "assertions": [
        {
          "path": "$.orderId",
          "operator": "STARTS_WITH",
          "value": "ORD-",
          "description": "Order ID must start with ORD-"
        },
        {
          "path": "$.customerId",
          "value": "CUST-99001",
          "description": "Customer ID must match request parameter"
        },
        {
          "path": "$.totalItems",
          "value": 3,
          "description": "Total items count must be 3"
        },
        {
          "path": "$.subtotal",
          "operator": "GREATER_THAN",
          "value": 100.0,
          "description": "Subtotal must be greater than 100.0"
        },
        {
          "path": "$.status",
          "value": "CREATED",
          "description": "Order status must be CREATED"
        }
      ]
    }
  ]
}
