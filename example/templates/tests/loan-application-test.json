{
  "requestPath": "../requests/loan-application-request.json",
  "tests": [
    {
      "name": "High Credit Score Loan Approval Test",
      "description": "Validates loan approval decision, prime interest rate assignment, and full requested amount approval for high credit score applicants.",
      "operation": "loan-application-service",
      "mutations": [
        {
          "path": "$.applicantId",
          "value": "APP-998877"
        },
        {
          "path": "$.requestedAmount",
          "value": 75000.00
        },
        {
          "path": "$.creditScore",
          "value": 780
        }
      ],
      "assertions": [
        {
          "path": "$.applicationId",
          "operator": "STARTS_WITH",
          "value": "APP-",
          "description": "Application ID must start with APP-"
        },
        {
          "path": "$.applicantId",
          "value": "APP-998877",
          "description": "Applicant ID must match request parameter"
        },
        {
          "path": "$.approvedAmount",
          "value": 75000.00,
          "description": "Approved amount must equal requested amount for high credit score"
        },
        {
          "path": "$.interestRate",
          "operator": "LESS_THAN_OR_EQUALS",
          "value": 7.0,
          "description": "Interest rate must be prime (<= 7.0%)"
        },
        {
          "path": "$.decisionStatus",
          "value": "APPROVED",
          "description": "Decision status must be APPROVED"
        }
      ]
    }
  ]
}
