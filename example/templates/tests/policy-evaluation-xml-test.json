{
  "xmlRequestPath": "../requests/complex-policy-request.xml",
  "tests": [
    {
      "name": "Test 1: Premium Calculation & Underwriter Region Verification from XML",
      "description": "Validates policy evaluation premium scaling and regional routing using a complex XML request template.",
      "operation": "policy-evaluation-service",
      "mutations": [
        {
          "path": "$.policyHeader.underwriter.code",
          "value": "UW-GLOBAL-01"
        },
        {
          "path": "$.coverageDetails.basePremium",
          "value": 25000.00
        }
      ],
      "assertions": [
        {
          "path": "$.policyNumber",
          "value": "POL-2026-88901",
          "description": "Policy number must match input header"
        },
        {
          "path": "$.status",
          "value": "APPROVED",
          "description": "High rating policy should be approved"
        },
        {
          "path": "$.totalPremium",
          "operator": "GREATER_THAN",
          "value": 25000.00,
          "description": "Total premium must exceed base premium due to endorsements"
        },
        {
          "path": "$.underwriterSummary.code",
          "operator": "STARTS_WITH",
          "value": "UW-",
          "description": "Underwriter code format check"
        }
      ]
    },
    {
      "name": "Test 2: Risk Flag Exclusion & Claims Inspection from XML",
      "description": "Validates risk score metric evaluation when reading from an XML request template.",
      "operation": "policy-evaluation-service",
      "mutations": [
        {
          "path": "$.insuredParty.riskMetrics.score",
          "value": 850
        },
        {
          "path": "$.insuredParty.riskMetrics.creditRating",
          "value": "AAA"
        }
      ],
      "assertions": [
        {
          "path": "$.creditRating",
          "value": "AAA",
          "description": "Credit rating must match updated parameter"
        },
        {
          "path": "$.riskScore",
          "value": 850,
          "description": "Risk score must match updated score"
        },
        {
          "path": "$.insuredPartyLegalName",
          "value": "Pathora Enterprise Solutions",
          "description": "Insured legal name must match XML input"
        },
        {
          "path": "$.underwritingSummary.tier",
          "value": "PREMIUM",
          "description": "High score must map to PREMIUM underwriting tier"
        }
      ]
    }
  ]
}
