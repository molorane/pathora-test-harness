{
  "requestPath": "../requests/payment-process-request.json",
  "tests": [
    {
      "name": "Successful Payment Processing Test",
      "description": "Validates successful payment gateway response, transaction reference, and positive amount.",
      "operation": "payment-gateway-service",
      "mutations": [
        {
          "path": "$.amount",
          "value": 499.99
        },
        {
          "path": "$.paymentMethod",
          "value": "DEBIT_CARD"
        }
      ],
      "assertions": [
        {
          "path": "$.paymentId",
          "operator": "STARTS_WITH",
          "value": "PAY-",
          "description": "Payment ID must be generated with PAY- prefix"
        },
        {
          "path": "$.transactionId",
          "value": "TXN-998811",
          "description": "Transaction ID must match input request"
        },
        {
          "path": "$.amount",
          "operator": "GREATER_THAN",
          "value": 0.0,
          "description": "Payment amount must be greater than zero"
        },
        {
          "path": "$.status",
          "value": "SUCCESS",
          "description": "Payment status must be SUCCESS"
        }
      ]
    }
  ]
}
