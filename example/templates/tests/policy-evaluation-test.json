{
  "requestPath": "../requests/complex-policy-request.json",
  "tests": [
    {
      "name": "Test 1: Policy Header & Underwriter Verification",
      "description": "Validates header prefix, email regex format, non-rejected status, map keys, and path existence.",
      "operation": "policy-evaluation-service",
      "mutations": [],
      "assertions": [
        {
          "path": "$.policyNumber",
          "operator": "STARTS_WITH",
          "value": "POL-",
          "description": "Policy number must start with POL- prefix"
        },
        {
          "path": "$.primaryContactEmail",
          "operator": "REGEX_MATCH",
          "value": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,6}$",
          "description": "Contact email must be valid email format"
        },
        {
          "path": "$.status",
          "operator": "NOT_EQUALS",
          "value": "REJECTED",
          "description": "Status must not be REJECTED"
        },
        {
          "path": "$.underwritingSummary",
          "operator": "HAS_KEYS",
          "value": [
            "approved",
            "score",
            "tier"
          ],
          "description": "Summary map must contain required key names"
        },
        {
          "path": "$.evaluationTimestamp",
          "operator": "PATH_EXISTS",
          "description": "Evaluation timestamp path must exist in response"
        }
      ]
    },
    {
      "name": "Test 2: Premium & Financial Bounds Verification",
      "description": "Validates premium thresholds, price range between bounds, discount limit, region value set, and field cross-equality.",
      "operation": "policy-evaluation-service",
      "mutations": [],
      "assertions": [
        {
          "path": "$.totalPremium",
          "operator": "GREATER_THAN",
          "value": 10000.0,
          "description": "Total premium must exceed 10000.0"
        },
        {
          "path": "$.finalPrice",
          "operator": "BETWEEN",
          "value": {
            "min": 10000.0,
            "max": 20000.0
          },
          "description": "Final price must be between 10000.0 and 20000.0"
        },
        {
          "path": "$.discountAmount",
          "operator": "LESS_THAN_OR_EQUALS",
          "value": 2000.0,
          "description": "Discount amount must not exceed 2000.0"
        },
        {
          "path": "$.underwriterRegion",
          "operator": "VALUE_IN",
          "value": [
            "AFRICA_SOUTH",
            "AFRICA_NORTH",
            "EUROPE"
          ],
          "description": "Region must be in allowed list"
        },
        {
          "path": "$.riskScore",
          "operator": "FIELD_EQUALS_OTHER_FIELD",
          "value": {
            "leftPath": "$.riskScore",
            "rightPath": "$.insuredRiskScore"
          },
          "description": "riskScore must equal insuredRiskScore"
        }
      ]
    },
    {
      "name": "Test 3: Clause Array & Requirements Inspection",
      "description": "Validates array size, document inclusion, tag subset completeness, list uniqueness, and empty exclusions list.",
      "operation": "policy-evaluation-service",
      "mutations": [],
      "assertions": [
        {
          "path": "$.approvedClauses",
          "operator": "LIST_SIZE_EQUALS",
          "value": 2,
          "description": "Approved clauses array must have exact size 2"
        },
        {
          "path": "$.requiredDocs",
          "operator": "LIST_CONTAINS",
          "value": "AUDIT_REPORT",
          "description": "Required docs must contain AUDIT_REPORT"
        },
        {
          "path": "$.approvedTags",
          "operator": "CONTAINS_ALL",
          "value": [
            "PROPERTY",
            "CYBER"
          ],
          "description": "Approved tags must contain all specified tags"
        },
        {
          "path": "$.uniqueReferenceCodes",
          "operator": "UNIQUE_ELEMENTS",
          "description": "Reference codes must contain no duplicates"
        },
        {
          "path": "$.emptyExclusions",
          "operator": "IS_EMPTY_LIST",
          "description": "Exclusions list must be empty"
        }
      ]
    },
    {
      "name": "Test 4: Object Composition & Risk Summary Validation",
      "description": "Validates map fields, map null-ignoring fields, nested object elements in arrays, absence of prohibited risk flags, and document presence.",
      "operation": "policy-evaluation-service",
      "mutations": [],
      "assertions": [
        {
          "path": "$.underwritingSummary",
          "operator": "OBJECT_CONTAINS_FIELDS",
          "value": {
            "tier": "PREMIUM",
            "approved": true
          },
          "description": "Summary object must contain specified key-value fields"
        },
        {
          "path": "$.underwritingSummary",
          "operator": "OBJECT_CONTAINS_FIELDS_IGNORE_NULLS",
          "value": {
            "tier": "PREMIUM",
            "score": 820
          },
          "description": "Summary object must contain fields ignoring null entries"
        },
        {
          "path": "$.approvedClauses",
          "operator": "LIST_CONTAINS_OBJECT_WITH_FIELDS",
          "value": {
            "clauseId": "CLS-01",
            "status": "APPROVED"
          },
          "description": "Approved clauses array must contain object matching fields"
        },
        {
          "path": "$.riskFlags",
          "operator": "DOES_NOT_CONTAIN_ANY",
          "value": [
            "BANKRUPTCY",
            "FRAUD"
          ],
          "description": "Risk flags must not contain BANKRUPTCY or FRAUD"
        },
        {
          "path": "$.requiredDocs",
          "operator": "CONTAINS_ANY",
          "value": [
            "TAX_CLEARANCE",
            "PASSPORT"
          ],
          "description": "Required docs must contain at least TAX_CLEARANCE or PASSPORT"
        }
      ]
    },
    {
      "name": "Test 5: Logical Composition Rules Verification",
      "description": "Validates composite AND rules, composite OR options, NOT negations, ALL_MATCH element criteria, and VALUE_NOT_IN constraints.",
      "operation": "policy-evaluation-service",
      "mutations": [],
      "assertions": [
        {
          "path": "$",
          "operator": "AND",
          "description": "Status must be APPROVED AND riskScore > 800",
          "assertions": [
            {
              "path": "$.status",
              "value": "APPROVED"
            },
            {
              "path": "$.riskScore",
              "operator": "GREATER_THAN",
              "value": 800
            }
          ]
        },
        {
          "path": "$",
          "operator": "OR",
          "description": "Region must be AFRICA_SOUTH or EUROPE",
          "assertions": [
            {
              "path": "$.underwriterRegion",
              "value": "AFRICA_SOUTH"
            },
            {
              "path": "$.underwriterRegion",
              "value": "EUROPE"
            }
          ]
        },
        {
          "path": "$",
          "operator": "NOT",
          "description": "Status must NOT be CANCELLED",
          "assertions": [
            {
              "path": "$.status",
              "value": "CANCELLED"
            }
          ]
        },
        {
          "path": "$.approvedClauses[*].limit",
          "operator": "ALL_MATCH",
          "value": {
            "greaterThan": 0
          },
          "description": "All approved clause limits must be greater than 0"
        },
        {
          "path": "$.status",
          "operator": "VALUE_NOT_IN",
          "value": [
            "REJECTED",
            "CANCELLED"
          ],
          "description": "Status must not be in excluded list"
        }
      ]
    }
  ]
}
