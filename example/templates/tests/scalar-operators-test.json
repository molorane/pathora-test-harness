{
  "requestPath": "../requests/loan-application-request.json",
  "tests": [
    {
      "name": "Scalar Number Classification Test",
      "description": "Tests IS_NUMBER, IS_DECIMAL, IS_INTEGER, IS_POSITIVE, IS_NEGATIVE, and IS_TRUE operators on monetary rates and amounts.",
      "operation": "loan-application-service",
      "mutations": [
        {
          "path": "$.creditScore",
          "value": 750
        },
        {
          "path": "$.requestedAmount",
          "value": 50000.00
        }
      ],
      "assertions": [
        {
          "path": "$.approvedAmount",
          "operator": "IS_NUMBER",
          "description": "Approved amount must be a number"
        },
        {
          "path": "$.approvedAmount",
          "operator": "IS_POSITIVE",
          "description": "Approved amount must be strictly positive"
        },
        {
          "path": "$.interestRate",
          "operator": "IS_DECIMAL",
          "description": "Interest rate has fractional decimal component"
        },
        {
          "path": "$.interestRate",
          "operator": "EQUALS_WITH_TOLERANCE",
          "value": {
            "value": 6.5,
            "tolerance": 0.1
          },
          "description": "Interest rate should equal 6.5 within 0.1 tolerance"
        },
        {
          "path": "$.creditTierScore",
          "operator": "IS_INTEGER",
          "description": "Credit tier score must be an integer"
        },
        {
          "path": "$.riskPenalty",
          "operator": "IS_NEGATIVE",
          "description": "Risk penalty must be a negative integer"
        },
        {
          "path": "$.eligible",
          "operator": "IS_TRUE",
          "description": "Eligible flag must be true"
        }
      ]
    },
    {
      "name": "Scalar Nullability & Tolerance Test",
      "description": "Tests IS_NOT_NULL, IS_NULL, IS_FALSE, and IS_ZERO operators on conditional/rejection paths.",
      "operation": "loan-application-service",
      "mutations": [
        {
          "path": "$.creditScore",
          "value": 500
        }
      ],
      "assertions": [
        {
          "path": "$.applicationId",
          "operator": "IS_NOT_NULL",
          "description": "Application ID must not be null"
        },
        {
          "path": "$.coSignerId",
          "operator": "IS_NULL",
          "description": "Co-signer ID must be null"
        },
        {
          "path": "$.requiresManualReview",
          "operator": "IS_FALSE",
          "description": "Requires manual review must be false"
        },
        {
          "path": "$.approvedAmount",
          "operator": "IS_ZERO",
          "description": "Approved amount must be zero for rejected loan"
        },
        {
          "path": "$.interestRate",
          "operator": "IS_ZERO",
          "description": "Interest rate must be zero for rejected loan"
        },
        {
          "path": "$.decisionStatus",
          "operator": "EQUALS",
          "value": "REJECTED",
          "description": "Decision status must be REJECTED"
        }
      ]
    }
  ]
}



