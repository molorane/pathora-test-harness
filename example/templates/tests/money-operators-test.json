{
  "requestPath": "../requests/complex-policy-request.json",
  "tests": [
    {
      "name": "Money Comparison & Scale Test",
      "description": "Tests MONEY_EQUALS, MONEY_GREATER_THAN, MONEY_GREATER_THAN_OR_EQUALS, MONEY_LESS_THAN, MONEY_LESS_THAN_OR_EQUALS, MONEY_BETWEEN, and MONEY_EQUALS_WITH_TOLERANCE operators on calculated totals.",
      "operation": "policy-evaluation-service",
      "mutations": [
        {
          "path": "$.coverageDetails.basePremium",
          "value": 15000.00
        }
      ],
      "assertions": [
        {
          "path": "$.basePremium",
          "operator": "MONEY_EQUALS",
          "value": 15000.00,
          "description": "Base premium matches exact monetary value"
        },
        {
          "path": "$.basePremium",
          "operator": "MONEY_GREATER_THAN_OR_EQUALS",
          "value": 15000.00,
          "description": "Base premium is greater than or equal to 15000.00"
        },
        {
          "path": "$.totalPremium",
          "operator": "MONEY_GREATER_THAN",
          "value": 10000.00,
          "description": "Total premium is greater than 10000.00"
        },
        {
          "path": "$.discountAmount",
          "operator": "MONEY_LESS_THAN",
          "value": 2000.00,
          "description": "Discount amount is less than 2000.00"
        },
        {
          "path": "$.discountAmount",
          "operator": "MONEY_LESS_THAN_OR_EQUALS",
          "value": 1000.00,
          "description": "Discount amount is less than or equal to 1000.00"
        },
        {
          "path": "$.finalPrice",
          "operator": "MONEY_BETWEEN",
          "value": {
            "min": 10000.00,
            "max": 20000.00
          },
          "description": "Final price falls within expected monetary range"
        },
        {
          "path": "$.basePremium",
          "operator": "MONEY_EQUALS_WITH_TOLERANCE",
          "value": {
            "expected": 15000.00,
            "tolerance": 50.00
          },
          "description": "Base premium matches within 50.00 tolerance"
        }
      ]
    }
  ]
}



